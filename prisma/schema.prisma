generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  AUDITOR
  TECHNICIAN
  OWNER
}

enum DefectPriority {
  P1
  P2
  P3
  P4
}

enum DefectSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AuditStatus {
  SCHEDULED
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  MISSED
  OWNER_REVIEWED
}

enum FitnessStatus {
  FIT
  UNFIT
  CONDITIONAL
}

enum DefectStatus {
  OPEN
  ASSIGNED
  REPAIRED_PENDING_CROSS
  VERIFIED
  REOPENED
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  code                String               @unique
  address             String?
  campuses            Campus[]
  departments         Department[]
  users               User[]
  assetCategories     AssetCategory[]
  rules               Rule[]
  venues              Venue[]
  assets              Asset[]
  audits              Audit[]
  defects             Defect[]
  scores              Score[]
  certificates        Certificate[]
  ownerQuestionBatches OwnerQuestionBatch[]
  ownerDefectReports  OwnerDefectReport[]
  crossAuditQuestions CrossAuditQuestion[]
  auditLogs           AuditLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Campus {
  id             String       @id @default(uuid())
  name           String
  code           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildings      Building[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Building {
  id        String   @id @default(uuid())
  name      String
  code      String
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  floors    Floor[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campusId])
}

model Floor {
  id         String   @id @default(uuid())
  name       String
  level      Int
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  venues     Venue[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([buildingId])
}

model Venue {
  id                  String               @id @default(uuid())
  name                String
  code                String               @unique
  type                String               @default("Cabin/Room")
  floorId             String
  floor               Floor                @relation(fields: [floorId], references: [id], onDelete: Cascade)
  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id])
  ownerId             String?
  owner               User?                @relation("VenueOwner", fields: [ownerId], references: [id])
  assets              Asset[]
  audits              Audit[]
  crossAuditQuestions CrossAuditQuestion[]
  scores              Score[]
  certificates        Certificate[]
  ownerQuestionBatches OwnerQuestionBatch[]
  ownerDefectReports   OwnerDefectReport[]
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([floorId])
  @@index([organizationId])
  @@index([ownerId])
  @@index([deletedAt])
}

model Department {
  id             String        @id @default(uuid())
  name           String        @unique
  code           String        @unique
  description    String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  users          User[]
  defects        Defect[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                Role
  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id])
  departmentId        String?
  department          Department?          @relation(fields: [departmentId], references: [id])
  buildingId          String?
  building            Building?            @relation(fields: [buildingId], references: [id])
  ownedVenues         Venue[]              @relation("VenueOwner")
  audits              Audit[]              @relation("AuditorAudits")
  repairs             Repair[]
  defects             Defect[]             @relation("TechnicianDefects")
  ownerResponses      OwnerResponse[]
  ownerDefectReports  OwnerDefectReport[]
  auditLogs           AuditLog[]
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([role])
  @@index([organizationId])
  @@index([departmentId])
  @@index([deletedAt])
}

model AssetCategory {
  id              String           @id @default(uuid())
  name            String           @unique
  code            String           @unique
  description     String?
  organizationId  String?
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  assets          Asset[]
  referenceImages ReferenceImage[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId])
}

model Asset {
  id               String            @id @default(uuid())
  serialNo         String            @unique
  name             String
  assetCategoryId  String
  assetCategory    AssetCategory     @relation(fields: [assetCategoryId], references: [id])
  venueId          String
  venue            Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  organizationId   String?
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  qrCode           String?
  installationDate DateTime?
  status           String            @default("ACTIVE")
  components       Component[]
  inspectionItems  InspectionItem[]
  defects          Defect[]
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([venueId])
  @@index([organizationId])
  @@index([assetCategoryId])
  @@index([status])
  @@index([deletedAt])
}

model Component {
  id              String           @id @default(uuid())
  name            String
  code            String
  assetId         String
  asset           Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspectionItems InspectionItem[]
  defects         Defect[]
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([assetId])
  @@index([deletedAt])
}

model ReferenceImage {
  id                 String        @id @default(uuid())
  assetCategoryId    String
  assetCategory      AssetCategory @relation(fields: [assetCategoryId], references: [id], onDelete: Cascade)
  goodImageUrl       String?
  acceptableImageUrl String?
  defectiveImageUrl  String?
  description        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([assetCategoryId])
}

model Rule {
  id             String         @id @default(uuid())
  componentType  String
  keywordMatch   String?
  category       String
  priority       DefectPriority
  severity       DefectSeverity
  departmentName String
  slaHours       Int
  autoEscalate   Boolean        @default(true)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([deletedAt])
}

model Audit {
  id                  String               @id @default(uuid())
  auditNo             String               @unique
  venueId             String
  venue               Venue                @relation(fields: [venueId], references: [id], onDelete: Cascade)
  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id])
  auditorId           String
  auditor             User                 @relation("AuditorAudits", fields: [auditorId], references: [id])
  managerId           String?
  status              AuditStatus          @default(SCHEDULED)
  scheduledDate       DateTime
  startTime           DateTime?
  dueDate             DateTime?
  completedDate       DateTime?
  missedReason        String?
  missedAt            DateTime?
  gpsLat              Float?
  gpsLng              Float?
  deviceInfo          String?
  inspectionItems     InspectionItem[]
  crossAuditResponses CrossAuditResponse[]
  score               Score?
  certificate         Certificate[]
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([auditorId])
  @@index([venueId])
  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
}

model InspectionItem {
  id          String    @id @default(uuid())
  auditId     String
  audit       Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id])
  componentId String
  component   Component @relation(fields: [componentId], references: [id])
  status      String    // PASS or FAIL
  photoUrl    String?
  geotagLat   Float?
  geotagLng   Float?
  remark      String?
  timestamp   DateTime  @default(now())
  defect      Defect?

  @@index([auditId])
  @@index([assetId])
  @@index([componentId])
  @@index([status])
}

model Defect {
  id               String         @id @default(uuid())
  defectNo         String         @unique
  inspectionItemId String         @unique
  inspectionItem   InspectionItem @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset          @relation(fields: [assetId], references: [id])
  componentId      String
  component        Component      @relation(fields: [componentId], references: [id])
  organizationId   String?
  organization     Organization?  @relation(fields: [organizationId], references: [id])
  category         String
  priority         DefectPriority
  severity         DefectSeverity
  departmentId     String
  department       Department     @relation(fields: [departmentId], references: [id])
  technicianId     String?
  technician       User?          @relation("TechnicianDefects", fields: [technicianId], references: [id])
  status           DefectStatus   @default(OPEN)
  slaDeadline      DateTime
  isOverdue        Boolean        @default(false)
  laborHours       Float?
  repairCost       Float?
  assignedAt       DateTime?
  reopenedReason   String?
  repair           Repair?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([technicianId])
  @@index([departmentId])
  @@index([organizationId])
  @@index([status])
  @@index([isOverdue])
  @@index([assetId])
  @@index([deletedAt])
}

model Repair {
  id                  String   @id @default(uuid())
  defectId            String   @unique
  defect              Defect   @relation(fields: [defectId], references: [id], onDelete: Cascade)
  technicianId        String
  technician          User     @relation(fields: [technicianId], references: [id])
  repairProofPhotoUrl String
  geotagLat           Float?
  geotagLng           Float?
  remark              String
  laborHours          Float?
  sparePartsUsed      String?
  completedAt         DateTime @default(now())

  @@index([technicianId])
}

model CrossAuditQuestion {
  id             String               @id @default(uuid())
  venueId        String
  venue          Venue                @relation(fields: [venueId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  question       String
  assetType      String
  expectedCount  Int?
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  correctAnswer  String // "A", "B", "C", "D"
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  responses      CrossAuditResponse[]

  @@index([venueId])
  @@index([organizationId])
}

model CrossAuditResponse {
  id              String             @id @default(uuid())
  auditId         String
  audit           Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  questionId      String
  question        CrossAuditQuestion @relation(fields: [questionId], references: [id])
  auditorResponse String
  isCorrect       Boolean
  createdAt       DateTime           @default(now())

  @@index([auditId])
  @@index([questionId])
}

model Score {
  id                    String        @id @default(uuid())
  auditId               String        @unique
  audit                 Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  venueId               String
  venue                 Venue         @relation(fields: [venueId], references: [id])
  organizationId        String?
  organization          Organization? @relation(fields: [organizationId], references: [id])
  housekeepingScore     Float
  electricalScore       Float
  plumbingScore         Float
  networkScore          Float
  documentationScore    Float
  overallScore          Float
  criticalFailuresCount Int
  isFit                 Boolean
  createdAt             DateTime      @default(now())

  @@index([venueId])
  @@index([organizationId])
}

model Certificate {
  id                  String        @id @default(uuid())
  certificateNo       String        @unique
  venueId             String
  venue               Venue         @relation(fields: [venueId], references: [id])
  auditId             String
  audit               Audit         @relation(fields: [auditId], references: [id])
  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id])
  fitnessStatus       FitnessStatus
  overallScore        Float
  validFrom           DateTime      @default(now())
  validUntil          DateTime
  qrCode              String?
  approvedByManagerId String?
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())

  @@index([venueId])
  @@index([auditId])
  @@index([organizationId])
  @@index([fitnessStatus])
  @@index([deletedAt])
}

model OwnerQuestionBatch {
  id             String          @id @default(uuid())
  venueId        String
  venue          Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  managerId      String?
  status         String          @default("ACTIVE") // ACTIVE, EXPIRED, AUTO_SUBMITTED, COMPLETED
  expiresAt      DateTime
  questions      OwnerQuestion[]
  responses      OwnerResponse[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([venueId])
  @@index([organizationId])
  @@index([status])
}

model OwnerQuestion {
  id        String             @id @default(uuid())
  batchId   String
  batch     OwnerQuestionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  question  String
  category  String             @default("General")
  responses OwnerResponse[]
  createdAt DateTime           @default(now())

  @@index([batchId])
}

model OwnerResponse {
  id         String             @id @default(uuid())
  batchId    String
  batch      OwnerQuestionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  questionId String
  question   OwnerQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User               @relation(fields: [ownerId], references: [id])
  answer     String // YES, NO, PARTIAL
  remark     String?
  answeredAt DateTime           @default(now())

  @@index([batchId])
  @@index([ownerId])
}

model OwnerDefectReport {
  id             String         @id @default(uuid())
  defectNo       String         @unique
  venueId        String
  venue          Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  ownerId        String
  owner          User           @relation(fields: [ownerId], references: [id])
  title          String
  description    String
  assetName      String?
  priority       DefectPriority @default(P3)
  severity       DefectSeverity @default(MEDIUM)
  status         DefectStatus   @default(OPEN)
  photoUrl       String?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([venueId])
  @@index([organizationId])
  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  action         String // e.g. AUDIT_APPROVED, DEFECT_ASSIGNED, REPAIR_SUBMITTED, RULE_CREATED
  entityType     String // e.g. Audit, Defect, Repair, Certificate
  entityId       String
  detailsJson    String? // JSON payload of change
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
